{
  "name": "dungthu-desktop-app",
  "version": "1.0.0",
  "description": "Desktop WebView Application for DungThu.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win --mac --linux"
  },
  "keywords": [
    "dungthu",
    "electron",
    "webview",
    "desktop-app"
  ],
  "author": "DungThu Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.dungthu.desktopapp",
    "productName": "Dùng Thử AI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "../../public/images/dungthu.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dùng Thử AI"
    }
  }
}
